{
  "name": "tc-cards",
  "private": true,
  "version": "1.0.0",
  "description": "An unofficial, offline pocket companion for the Table Conversations questions.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "cards": "node scripts/build-cards.mjs",
    "icons": "node scripts/make-icons.mjs",
    "stamp": "node scripts/stamp-sw.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "predeploy": "node scripts/stamp-sw.mjs --check && node --test \"tests/*.test.mjs\"",
    "deploy": "vercel deploy --prod"
  }
}
